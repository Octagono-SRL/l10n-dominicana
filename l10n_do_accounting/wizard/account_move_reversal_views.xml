<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Ported for Odoo 17.0: core replaced the old refund_method radio
         field (values 'refund'/'cancel'/'modify') with two separate
         footer buttons (refund_moves / modify_moves), each calling the
         same reverse_moves(is_modify=...) directly; refund_method is
         gone from both the view and the model entirely. Reproduced live,
         this exact gap crashed production's own post-migration DEPLOY:
         "Element xpath refund_method cannot be located in parent view".
         This module's own fields (refund_type/refund_action) already
         expressed a finer-grained choice than refund_method ever did,
         and account_move_reversal.py (this same module) now computes
         is_modify from refund_action directly instead of bridging
         through the removed field; see that file's own reverse_moves()
         override. Re-anchored every xpath below to fields that still
         exist on the simplified 17.0 form (reason/date), and
         'refund_method' comparisons inside l10n_latam_document_type_id's
         own conditions became 'refund_action' == 'draft_refund' (the
         exact same case onchange_refund_action used to map to
         refund_method == 'refund', before that bridging method existed
         at all). -->
    <record id="view_account_move_reversal_inherited" model="ir.ui.view">
        <field name="name">view.account.move.reversal.inherited</field>
        <field name="model">account.move.reversal</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="account.view_account_move_reversal"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="country_code" invisible="1"/>
                <field name="is_ecf_invoice" invisible="1"/>
            </field>
            <field name="l10n_latam_document_type_id" position="attributes">
                <attribute name="invisible">(refund_action == 'draft_refund' and country_code != 'DO') or move_type == 'out_invoice'</attribute>
                <attribute name="required">l10n_latam_use_documents == True and refund_action != 'draft_refund'</attribute>
            </field>
            <field name="l10n_latam_document_number" position="replace">
                <field name="l10n_latam_document_number"
                       invisible="l10n_latam_manual_document_number == False" required="move_type == 'in_invoice' and l10n_latam_manual_document_number == True"/>
            </field>
            <field name="reason" position="before">
                <field name="refund_type" options="{'horizontal': true}"
                       widget="radio"/>
                <field name="refund_action" widget="radio"
                       invisible="refund_type == 'full_refund'"/>
            </field>
            <field name="reason" position="after">
                <field name="percentage"
                       invisible="refund_type != 'percentage'" required="refund_type == 'percentage'"/>
                <field name="amount"
                       invisible="refund_type != 'fixed_amount'" required="refund_type == 'fixed_amount'"/>
                <field name="l10n_do_ecf_modification_code"
                       invisible="(l10n_latam_manual_document_number == True or is_ecf_invoice == False)" required="l10n_latam_manual_document_number == False and is_ecf_invoice == True"/>
            </field>
            <field name="date" position="after">
                <group invisible="refund_type == 'full_refund'">
                    <div invisible="refund_action != 'draft_refund'" class="oe_grey" colspan="4">
                        You will be able to edit and validate this
                        credit note directly or keep it draft.
                     </div>
                    <div invisible="refund_action != 'apply_refund'" class="oe_grey" colspan="4">
                        Use this option if you want to fully apply a credit note.
                        The credit note will be created, validated and reconciled
                        with the invoice. You will not be able to modify the credit note.
                     </div>
                </group>
            </field>
        </field>
    </record>

</odoo>
