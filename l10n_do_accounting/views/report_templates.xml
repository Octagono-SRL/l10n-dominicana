<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="web_address_layout_inherited" inherit_id="web.address_layout">
        <!-- do not show company address on document header; in 17.0 core
             moved t-if="address" from a wrapping <t> element directly onto
             the <div>, so the old //t[@t-if='address']/div xpath no longer
             matches anything (reproduced live against the real odoo:17.0
             image). Target the div directly and keep the original address
             check intact alongside our own condition. -->
        <xpath expr="//div[@t-if='address']" position="attributes">
            <attribute name="t-if">address and (doc_model != "account.move" or (doc_model == "account.move" and o.country_code != "DO"))</attribute>
        </xpath>
    </template>

    <!-- do not show company address on document header when l10n do invoice.
         20.0 replaced the 4 separate full-layout templates this used to
         patch (external_layout_bold/standard/striped/boxed, each with its
         own <div name="company_address">) with 8 report-style templates
         (wave/bubble/folder/center/dual/lines/compact/standard) that all
         delegate to one shared web.company_address_list template instead,
         so a single patch there now covers every style. -->
    <template id="company_address_list_do_inherited" inherit_id="web.company_address_list">
        <xpath expr="//ul[@name='company_address_list']" position="attributes">
            <attribute name="t-if">doc_model != "account.move" or (doc_model == "account.move" and o.country_code != "DO")</attribute>
        </xpath>
    </template>

</odoo>
