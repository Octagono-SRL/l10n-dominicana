<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="restrict_mode_hash_table" position="after">
                <field name="is_ecf_invoice" invisible="1"/>
                <field name="l10n_do_company_in_contingency" invisible="1"/>
                <field name="l10n_do_enable_first_sequence" invisible="1" force_save="1"/>
                <field name="l10n_do_show_expiration_date_msg" invisible="1"/>
            </field>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning"
                     role="alert" style="margin-bottom:0px;"
                     invisible="(((move_type == 'entry' or country_code != 'DO') or l10n_do_company_in_contingency == False) or state != 'draft')">
                    Notice. This company is in a transient state of contingency for Electronic Invoice issuing. NCF issuing has been enabled.
                </div>
                <div class="alert alert-warning"
                     role="alert" style="margin-bottom:0px;"
                     invisible="(((move_type == 'entry' or country_code != 'DO') or l10n_do_show_expiration_date_msg == False) or state != 'draft')">
                    Notice. Document Number field enabled because a new Fiscal Number Expiration date was set on journal
                </div>
            </xpath>
            <xpath expr="//button[@name='button_cancel']" position="attributes">
                <attribute name="invisible">id == False or (state != 'draft' and country_code != 'DO') or (state in ('draft', 'cancel') and country_code == 'DO')</attribute>
            </xpath>
            <xpath expr="//button[@name='button_draft']" position="attributes">
                <attribute name="invisible">restrict_mode_hash_table == True or (state not in ('posted', 'cancel') and country_code != 'DO') or (state != 'cancel' and country_code == 'DO')</attribute>
            </xpath>
            <xpath expr="//h1/span/.." position="after">
                <h4 invisible="(state != 'cancel' or country_code != 'DO')">
                    Cancellation Reason:
                    <br/>
                    <field name="l10n_do_cancellation_type" readonly="1"/>
                </h4>
            </xpath>
            <xpath expr="//field[@name='l10n_latam_document_number']" position="attributes">
                <attribute name="invisible">(((l10n_latam_use_documents == False and country_code == 'DO') or (l10n_do_enable_first_sequence == False and (l10n_latam_manual_document_number == False and state == 'draft'))) or (l10n_do_enable_first_sequence == False and (l10n_latam_manual_document_number == True and (state == 'draft' and (move_type in ('out_invoice', 'out_refund', 'in_refund') and country_code == 'DO')))))</attribute>
<attribute name="readonly">(state != 'draft' and country_code == 'DO')</attribute>
<attribute name="required">((l10n_do_enable_first_sequence == True or l10n_latam_manual_document_number == True) and l10n_latam_use_documents == True) and country_code == 'DO'</attribute>
            </xpath>
            <!-- Was a positional selector (form[1]/sheet[1]/group[1]/group[1]/
                 field[@name='partner_id']), assuming partner_id was a direct
                 child of that inner group. Odoo 17.0 wraps it in an
                 intervening div.o_col instead (verified live against the
                 real odoo:17.0 image), breaking the direct-child
                 assumption; reproduced live, this exact gap crashed
                 production's post-migration DEPLOY. widget=
                 'res_partner_many2one' uniquely identifies this specific
                 partner_id field on this form (there is a second, unrelated
                 one inside the invoice lines tree, column_invisible, no
                 such widget), so this is both more robust against future
                 layout changes and no longer coupled to nesting depth. -->
            <xpath expr="//field[@name='partner_id'][@widget='res_partner_many2one']" position="after">
                <xpath expr="//field[@name='l10n_latam_document_type_id']" position="move"/>
                <xpath expr="//field[@name='l10n_latam_document_number']" position="move"/>
                <!-- the stored twin of l10n_latam_document_number must travel with the
                     form, otherwise onchange rebuilds the record without it and the
                     derived document number gets recomputed to empty -->
                <field name="l10n_do_fiscal_number" invisible="1"/>
                <field name="l10n_do_origin_ncf" invisible="((move_type not in ('in_refund', 'out_refund') and debit_origin_id == False) or (move_type in ('in_refund', 'out_refund') and (l10n_latam_use_documents == False or country_code != 'DO')))" readonly="state != 'draft'" required="((move_type in ('in_refund', 'out_refund') and l10n_latam_use_documents == True) or debit_origin_id != False)"/>
                <field name="l10n_do_ecf_modification_code" readonly="state != 'draft'" invisible="((((move_type not in ('in_refund', 'out_refund') and debit_origin_id == False) or (move_type in ('in_refund', 'out_refund') and is_ecf_invoice == False)) or (debit_origin_id != False and is_ecf_invoice == False)) or country_code != 'DO')" required="(is_ecf_invoice == True and (move_type in ('in_refund', 'out_refund') or debit_origin_id != False))"/>
            </xpath>
            <xpath expr="//field[@name='l10n_latam_document_number']" position="after">
                <field name="l10n_do_income_type" invisible="(l10n_latam_use_documents == False or (move_type != 'out_invoice' or country_code != 'DO'))" readonly="state != 'draft'" required="(l10n_latam_use_documents == True and move_type == 'out_invoice')"/>
                <field name="l10n_do_expense_type" invisible="(l10n_latam_use_documents == False or (move_type != 'in_invoice' or country_code != 'DO'))" readonly="state != 'draft'" required="(l10n_latam_use_documents == True and move_type == 'in_invoice')"/>
            </xpath>
            <xpath expr="//div[@name='journal_div']" position="after">
                <field name="l10n_do_ecf_security_code" invisible="(((partner_id == False or country_code != 'DO') or l10n_latam_manual_document_number == False) or is_ecf_invoice == False)"/>
            </xpath>

            <!-- only computed when l10n_do ecf invoice -->
            <xpath expr="//page[@id='invoice_tab']/field[@name='invoice_line_ids']/list/field[@name='tax_ids']" position="after">
                <field name="l10n_do_itbis_amount" invisible="1" force_save="1"/>
            </xpath>
            <!-- payment_id no longer exists in this tree at all in Odoo
                 16.0 core (verified live against the odoo:16.0 image's own
                 account/views/account_move_views.xml): this field is
                 invisible/force_save, purely a data holder, so any stable
                 field in the same tree works as the anchor; account_id is
                 the tree's own first field and always present. -->
            <xpath expr="//page[@id='aml_tab']/field[@name='line_ids']/list/field[@name='account_id']" position="after">
                <field name="l10n_do_itbis_amount" invisible="1" force_save="1"/>
            </xpath>
        </field>
    </record>

    <!-- Exclude debit notes from actual vendor/customer invoices actions -->
    <record id="account.action_move_out_invoice_type" model="ir.actions.act_window">
        <field name="domain">[('move_type', '=', 'out_invoice'), ('debit_origin_id', '=', False)]</field>
    </record>
    <record id="account.action_move_in_invoice_type" model="ir.actions.act_window">
        <field name="domain">[('move_type', '=', 'in_invoice'), ('debit_origin_id', '=', False)]</field>
    </record>

    <!-- Out Debit Notes -->
    <record id="action_invoice_out_debit_note" model="ir.actions.act_window">
        <field name="name">Debit Notes</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_ids"
               eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'list', 'view_id': ref('account.view_invoice_tree')}),
                          (0, 0, {'view_mode': 'form', 'view_id': ref('account.view_move_form')})]"/>
        <field name="domain">[('move_type','=','out_invoice'), ('debit_origin_id', '!=', False)]</field>
        <field name="context">{
            'default_type': 'out_invoice',
            'move_type': 'out_invoice',
            'journal_type': 'sale',
            'internal_type': 'debit_note',
            }</field>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a debit note
            </p>
            <p>
                Note that the easiest way to create a debit note is to do it directly
                from the customer invoice.
            </p>
        </field>
    </record>

    <menuitem action="action_invoice_out_debit_note"
              id="menu_action_invoice_out_debit_note"
              parent="account.menu_finance_receivables"
              sequence="2"/>

    <!-- In Debit Notes -->
    <record id="action_vendor_in_debit_note" model="ir.actions.act_window">
        <field name="name">Vendor Debit Notes</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form</field>
        <field eval="False" name="view_id"/>
        <field name="domain">[('move_type','=','in_invoice'), ('debit_origin_id', '!=', False)]</field>
        <field name="context">{
            'default_type': 'in_invoice',
            'move_type': 'in_invoice',
            'journal_type': 'purchase',
            'journal_type': 'purchase',
            'internal_type': 'debit_note',
            }</field>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record a new vendor debit note
            </p>
        </field>
    </record>

    <menuitem action="action_vendor_in_debit_note"
              id="menu_action_invoice_in_debit_note"
              parent="account.menu_finance_payables"
              groups="l10n_do_accounting.group_l10n_do_debit_note"
              sequence="10"/>

    <record id="view_invoice_tree" model="ir.ui.view">
        <field name="name">view.invoice.tree</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="ref" position="after">
                <field name="l10n_do_fiscal_number"/>
            </field>
        </field>
    </record>

    <record id="view_account_move_filter" model="ir.ui.view">
        <field name="name">view.account.move.filter</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter"/>
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="filter_domain">[
                    '|', '|', '|',
                    ('name', 'ilike', self),
                    ('ref', 'ilike', self),
                    ('partner_id', 'ilike', self),
                    ('l10n_do_fiscal_number', 'ilike', self)
                ]</attribute>
            </field>
        </field>
    </record>

</odoo>
